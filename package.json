{
  "name": "cad-erlc",
  "productName": "CAD ERLC",
  "version": "0.1.0",
  "description": "CAD (Computer Aided Dispatch) con radio de voz para comunidades de ER:LC",
  "main": "main.js",
  "author": "Comunidad CAD ER:LC",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "server": "node server/signaling.js",
    "test-server": "node server/self-test.js",
    "build": "electron-builder --win"
  },
  "dependencies": {
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "es.caderlc.app",
    "productName": "CAD ERLC",
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "server/**/*"
    ]
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "electron@44.9.0": true,
    "electron-builder@26.15.3": true
  }
}
